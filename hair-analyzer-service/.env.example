# ========================================================
# Hair Analyzer Service - Environment Configuration
# ========================================================

# Service Metadata
PROJECT_NAME=hair-analyzer-service
VERSION=1.0.0
DEBUG=false
API_V1_STR=/api/v1

# CORS Settings (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Face Landmark & Pose Validation Constraints
MAX_TILT_DEGREES=25.0
AUTO_DESKEW_ROLL=true

# MediaPipe Inference Parameters
STATIC_IMAGE_MODE=true
MAX_NUM_FACES=1
REFINE_LANDMARKS=true
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# Maximum Upload Size in Bytes (15 MB)
MAX_IMAGE_SIZE_BYTES=15728640

# Virtual Hair Try-On (Hugging Face Inference)
# Optional Hugging Face token for higher rate limits (free from https://huggingface.co/settings/tokens)
HF_TOKEN=
HAIRFASTGAN_SPACE=AIRI-Institute/HairFastGAN
TRYON_TIMEOUT_SECONDS=90

